# Copy to .env — or just run the app once, which creates .env and
# generates FERNET_KEY automatically if this file doesn't exist yet.
#
# FERNET_KEY encrypts the JSON payload inside every payslip's QR code.
# Anyone with this key can decrypt and verify a payslip's QR code; anyone
# without it cannot. Treat it like a password:
#   - never commit the real .env (it's already in .gitignore)
#   - back it up alongside data/payroll.db — losing this key makes every
#     QR code issued so far permanently unverifiable, even though the
#     PDFs themselves remain perfectly readable
#   - use a different key per company/deployment; do not reuse one key
#     across installations that shouldn't be able to verify each other's payslips
#
# Generate one manually with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

FERNET_KEY=
